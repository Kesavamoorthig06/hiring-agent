# Default model to use (must exist in providers.json).
# Ollama examples: "gemma4:latest", "qwen3:4b", "mistral:7b"
# Gemini examples: "gemini-2.5-pro", "gemini-2.5-flash"
# OpenAI example: "gpt-6-luna"
DEFAULT_MODEL=gemma4:latest

# API keys — only needed for providers whose api_key_env is set in providers.json.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Gemini key pool. Add keys by appending to GEMINI_API_KEYS (comma separated) and restarting the revision.
# GEMINI_API_KEYS=key1,key2,key3
# Free-tier guards apply per project and model, not per key.
# KEY_PROJECTS maps key last4 to AI Studio project; unmapped keys have unknown grouping.
# KEY_PROJECTS=AAAA=pool-1,BBBB=pool-1,CCCC=pool-2
# PROJECT_RPM=5
# Rotate at KEY_ROTATE_AT of the daily request limit; warn below POOL_WARN_FRACTION capacity.
# KEY_DAILY_REQUESTS=20
# KEY_DAILY_TOKENS=0
# KEY_ROTATE_AT=0.85
# POOL_WARN_FRACTION=0.25
# POOL_MAX_PARK_WAIT=90
